import {
  "bobzhang/moonjq",
  "moonbitlang/async",
  "moonbitlang/async/io",
  "moonbitlang/async/stdio",
  "moonbitlang/core/argparse",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
  "moonbitlang/x/fs",
  "moonbitlang/x/sys",
}

pkgtype(kind: "executable")

options(
  targets: {
    "main_native.mbt": [ "native", "llvm" ],
    "main_wasm.mbt": [ "wasm", "wasm-gc", "js" ],
  },
)
